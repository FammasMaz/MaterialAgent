<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Background notifications. The Hermes gateway has no push infrastructure
      (no FCM/APNs server side), so genuine remote push is impossible; the
      mechanism is a foreground service keeping the WebSocket alive while the
      app is backgrounded, plus local notifications raised from live events.
      POST_NOTIFICATIONS is the runtime permission on API 33+; the two
      FOREGROUND_SERVICE permissions are required to start a dataSync-type
      foreground service from API 34.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Required before the updater may hand a downloaded APK to the platform
      installer. Without it `canRequestPackageInstalls()` does not return false —
      it throws SecurityException, which took the whole app down the moment the
      user tapped Install. Declaring it lets the app instead detect that the
      "install unknown apps" grant is missing and send the user to that setting.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Cleartext is governed by the network security config, not by the blanket
      `usesCleartextTraffic` flag that used to sit here. That flag allowed plain
      HTTP to any host the user typed, and the password sign-in goes out over
      whatever scheme the address names.
    -->
    <application
        android:name=".MaterialAgentApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialAgent"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MaterialAgent.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the Hermes socket alive while backgrounded and raises the
             local notifications the (push-less) gateway cannot send. dataSync
             is the closest declared type: the work is keeping a data channel
             open, not media playback or location. -->
        <service
            android:name=".notify.NotifyForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Sole reason this app declares a provider: a downloaded update APK
             lives in the app's own cache, and the platform installer cannot read
             another app's files without a content:// URI. It exposes the one
             `updates/` cache directory and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
