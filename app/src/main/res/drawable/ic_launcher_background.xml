<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's backdrop: a single indigo-to-violet gradient that the
  foreground illustration is composed onto. It is a drawable rather than the flat
  @color/ic_launcher_background it replaces because a pale flat fill made the icon
  read as washed out next to the artwork's saturated line work.

  angle=270 runs the gradient from the top of the 108dp layer to its bottom, so the
  indigo sits behind the head and the violet behind the shapes streaming upward.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#6A35C8"
        android:startColor="#3A1A7A"
        android:type="linear" />
</shape>