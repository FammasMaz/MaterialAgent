    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wings (blades), gold -->
    <path
        android:fillColor="#FFC24B"
        android:pathData="M53,42 L24,31 L27.5,41 L47,47.5 Z" />
    <path
        android:fillColor="#FFC24B"
        android:pathData="M55,42 L84,31 L80.5,41 L61,47.5 Z" />
    <path
        android:fillColor="#F5B23C"
        android:pathData="M53,50 L30,43 L33,52 L48,56.5 Z" />
    <path
        android:fillColor="#F5B23C"
        android:pathData="M55,50 L78,43 L75,52 L60,56.5 Z" />

    <!-- Staff -->
    <path
        android:pathData="M54,33 L54,87"
        android:strokeColor="#FFE9C0"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Apex -->
    <path
        android:fillColor="#FFE9C0"
        android:pathData="M54,21 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />

    <!-- Twin serpents -->
    <path
        android:pathData="M45,49 C61,55 49,63 54,73"
