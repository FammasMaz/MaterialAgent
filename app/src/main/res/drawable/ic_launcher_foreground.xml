<?xml version="1.0" encoding="utf-8"?>
<!-- MaterialAgent mark: geometric caduceus — the staff, twin serpents and
     wings of Hermes, reduced to strokes and blades so it stays legible at
     24 dp and reads as a single confident gesture at 108 dp. -->
